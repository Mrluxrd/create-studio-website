# Copy to .env (or set in your host's environment) before deploying.
# Nothing here is a secret — every value ships to the browser.

# Confirmed production origin. Used for canonical URLs, Open Graph URLs,
# robots.txt and the XML sitemap. No trailing slash.
PUBLIC_SITE_ORIGIN="https://PRODUCTION-DOMAIN.example"

# Where the contact form posts. Any form service that accepts a
# multipart/form-data POST and answers 2xx works (Netlify Forms AJAX endpoint,
# Formspree, Basin, Web3Forms...). Until this is set the form validates
# normally but shows its "That did not send." state instead of reporting a
# delivery that did not happen.
PUBLIC_CONTACT_ENDPOINT=""
