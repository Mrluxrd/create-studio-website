    <span style="font-family:Inter,system-ui,sans-serif;font-size:10.5px;line-height:1.6;color:#52525B">16:9 card crop · focal centre-right</span>
  </div></div>
  <div style="padding:28px 30px 30px;display:flex;flex-direction:column;gap:12px;flex:1">
    <div data-row="" style="display:flex;align-items:baseline;justify-content:space-between;gap:14px">
      <h2 data-h3="" style="margin:0;font-family:Sora,sans-serif;font-size:24px;font-weight:600;letter-spacing:-0.02em">Luxury Listings DR</h2>
      
    </div>
    <div style="font-size:12.5px;color:#8B5CF6">Luxury Real Estate Platform</div>
    <p style="margin:2px 0 0;font-size:14.5px;color:#A1A1AA;line-height:1.7">Luxury property discovery, made visual and unhurried. In development.</p>
    <div style="font-size:12.5px;color:#52525B;line-height:1.6">Web Design · User Experience · Responsive Design</div>
    <span style="margin-top:auto;padding-top:16px;font-size:13.5px;color:#8B5CF6;display:flex;align-items:center;gap:8px">View Case Study <span aria-hidden="true">→</span></span>
  </div>
</a><a href="/work/joan-leonardo" data-route="work-joan-leonardo" data-card="Website Redesign" aria-label="View the Joan Leonardo case study" style="display:flex;flex-direction:column;gap:0;border-radius:26px;background:#0E0E12;border:1px solid rgba(248,250,252,.08);overflow:hidden;transition:transform .35s cubic-bezier(.22,.61,.36,1),border-color .35s ease" data-sh="13">
  <div data-art-id="joan-leonardo-case-study" data-art="" data-art-slot="" style="position:relative;aspect-ratio:16/9;width:100%;overflow:hidden;background:#0B0B0E;border:1px solid rgba(248,250,252,.07);display:flex;align-items:flex-end"><Artwork id="joan-leonardo-case-study" />
  <div data-art-note="" style="padding:18px 20px;display:flex;flex-direction:column;gap:5px;max-width:520px">
    <span style="font-family:Inter,system-ui,sans-serif;font-weight:500;font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:#8B5CF6">ARTWORK — JOAN LEONARDO CASE STUDY</span>
    <span style="font-family:Inter,system-ui,sans-serif;font-size:10.5px;line-height:1.6;color:#52525B">16:9 card crop · focal left of centre</span>
  </div></div>
  <div style="padding:28px 30px 30px;display:flex;flex-direction:column;gap:12px;flex:1">
    <div data-row="" style="display:flex;align-items:baseline;justify-content:space-between;gap:14px">
      <h2 data-h3="" style="margin:0;font-family:Sora,sans-serif;font-size:24px;font-weight:600;letter-spacing:-0.02em">Joan Leonardo</h2>
      
    </div>
