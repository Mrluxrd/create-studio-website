---
import Base from '../../layouts/Base.astro';
import Artwork from '../../components/Artwork.astro';
---

<Base pageKey="work">
<main>
<section data-hero="" data-pad="" style="max-width:1440px;margin:0 auto;padding:96px 72px 56px;display:flex;flex-direction:column;gap:22px">
  <div style="font-family:Inter,system-ui,sans-serif;font-weight:500;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:#8B5CF6">Portfolio</div>
  <h1 data-h1="" style="margin:0;font-family:Sora,sans-serif;font-size:64px;font-weight:700;letter-spacing:-0.035em;line-height:1.03">Selected work.<br>One standard of execution.</h1>
  <p data-lead="" style="margin:0;font-size:19px;line-height:1.7;color:#A1A1AA;max-width:720px;text-wrap:pretty">Four projects, four different problems. What connects them is the same insistence on clarity — in how a business is presented, and in how the thing actually works.</p>
</section>
<section data-sect="" data-pad="" style="max-width:1440px;margin:0 auto;padding:0 72px 110px;display:flex;flex-direction:column;gap:34px">
