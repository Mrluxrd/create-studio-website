  <div data-art-note="" style="padding:18px 20px;display:flex;flex-direction:column;gap:5px;max-width:520px">
    <span style="font-family:Inter,system-ui,sans-serif;font-weight:500;font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:#8B5CF6">ARTWORK — CREATE STUDIO CASE STUDY</span>
    <span style="font-family:Inter,system-ui,sans-serif;font-size:10.5px;line-height:1.6;color:#52525B">21:9 feature crop · focal centre</span>
  </div></div>
  <div style="padding:34px 38px 38px;display:flex;flex-direction:column;gap:13px;flex:1">
    <div data-row="" style="display:flex;align-items:baseline;justify-content:space-between;gap:14px">
      <h2 data-h2="" style="margin:0;font-family:Sora,sans-serif;font-size:36px;font-weight:600;letter-spacing:-0.03em">Create Studio</h2>
      <span style="font-family:Inter,system-ui,sans-serif;font-weight:500;font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:#8B5CF6;border:1px solid rgba(139,92,246,.35);border-radius:999px;padding:4px 10px;flex:none">Featured project</span>
    </div>
    <div style="font-size:12.5px;color:#8B5CF6">Brand &amp; Digital Experience</div>
    <p style="margin:2px 0 0;font-size:16px;color:#A1A1AA;line-height:1.7;max-width:760px">Our own brand and website, built as one system — the clearest statement of how we think about design, technology and commercial intent.</p>
    <div style="font-size:12.5px;color:#52525B;line-height:1.6">Brand Application · Digital Art Direction · Web Design</div>
    <span style="margin-top:auto;padding-top:16px;font-size:13.5px;color:#8B5CF6;display:flex;align-items:center;gap:8px">View Case Study <span aria-hidden="true">→</span></span>
  </div>
</a></div>
</section>
<section data-sect="" data-pad="" style="padding:0 72px 120px;max-width:1440px;margin:0 auto">
  <div style="padding:80px 60px;border-radius:28px;background:#0B0B0E;border:1px solid rgba(248,250,252,.08);text-align:center;display:flex;flex-direction:column;align-items:center;gap:22px">
    <h2 data-h2="" data-rv="" style="margin:0;font-family:Sora,sans-serif;font-size:42px;font-weight:700;letter-spacing:-0.03em;line-height:1.08;max-width:720px">Your project could be the next one here.</h2>
    <p data-lead="" style="margin:0;font-size:17px;color:#A1A1AA;line-height:1.7;max-width:600px">Tell us what you are building, and what it needs to do. We will review the details and recommend the right starting point.</p>
    <div data-row="" style="display:flex;gap:14px;margin-top:4px"><a href="/contact" data-route="contact" data-btn-primary="" style="padding:16px 30px;border-radius:999px;background:linear-gradient(90deg,#2563FF,#8B5CF6,#2563FF);font-weight:600;font-size:15px;text-align:center">Start a Project</a><a href="/services" data-route="services" data-btn-ghost="" style="padding:16px 30px;border-radius:999px;border:1px solid rgba(248,250,252,.16);font-weight:500;font-size:15px;text-align:center">Explore the Services</a></div>
  </div>
</section>
<section data-slogan="" data-pad="" style="position:relative;z-index:1;padding:104px 72px 120px;max-width:1440px;margin:0 auto;display:flex;justify-content:center;text-align:center">
  <p style="margin:0;font-family:Sora,sans-serif;font-weight:700;font-size:54px;letter-spacing:-0.035em;line-height:1.05;text-wrap:pretty">We Create. <span style="background:linear-gradient(90deg,#2563FF,#8B5CF6);-webkit-background-clip:text;background-clip:text;color:transparent">You Grow.</span></p>
</section>
</main>
</Base>
