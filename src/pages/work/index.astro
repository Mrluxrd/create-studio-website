    <button type="button" data-filter="All" aria-pressed="true" data-on-click="setFilter" style="padding:11px 20px;border-radius:999px;border:1px solid rgba(139,92,246,.55);background:rgba(139,92,246,.12);color:#F8FAFC;font-family:Inter,sans-serif;font-size:13.5px;cursor:pointer;min-height:44px;display:flex;align-items:center;gap:8px;transition:border-color .25s ease,background .25s ease,color .25s ease"><span data-dot="" style="width:5px;height:5px;border-radius:99px;background:#8B5CF6;transition:background .25s ease"></span>All</button><button type="button" data-filter="Websites" aria-pressed="false" data-on-click="setFilter" style="padding:11px 20px;border-radius:999px;border:1px solid rgba(248,250,252,.14);background:transparent;color:#A1A1AA;font-family:Inter,sans-serif;font-size:13.5px;cursor:pointer;min-height:44px;display:flex;align-items:center;gap:8px;transition:border-color .25s ease,background .25s ease,color .25s ease"><span data-dot="" style="width:5px;height:5px;border-radius:99px;background:transparent;transition:background .25s ease"></span>Websites</button><button type="button" data-filter="Website Redesign" aria-pressed="false" data-on-click="setFilter" style="padding:11px 20px;border-radius:999px;border:1px solid rgba(248,250,252,.14);background:transparent;color:#A1A1AA;font-family:Inter,sans-serif;font-size:13.5px;cursor:pointer;min-height:44px;display:flex;align-items:center;gap:8px;transition:border-color .25s ease,background .25s ease,color .25s ease"><span data-dot="" style="width:5px;height:5px;border-radius:99px;background:transparent;transition:background .25s ease"></span>Website Redesign</button><button type="button" data-filter="CRM &amp; Systems" aria-pressed="false" data-on-click="setFilter" style="padding:11px 20px;border-radius:999px;border:1px solid rgba(248,250,252,.14);background:transparent;color:#A1A1AA;font-family:Inter,sans-serif;font-size:13.5px;cursor:pointer;min-height:44px;display:flex;align-items:center;gap:8px;transition:border-color .25s ease,background .25s ease,color .25s ease"><span data-dot="" style="width:5px;height:5px;border-radius:99px;background:transparent;transition:background .25s ease"></span>CRM &amp; Systems</button><button type="button" data-filter="Brand &amp; Digital" aria-pressed="false" data-on-click="setFilter" style="padding:11px 20px;border-radius:999px;border:1px solid rgba(248,250,252,.14);background:transparent;color:#A1A1AA;font-family:Inter,sans-serif;font-size:13.5px;cursor:pointer;min-height:44px;display:flex;align-items:center;gap:8px;transition:border-color .25s ease,background .25s ease,color .25s ease"><span data-dot="" style="width:5px;height:5px;border-radius:99px;background:transparent;transition:background .25s ease"></span>Brand &amp; Digital</button>
  </div>
  <div data-grid=""><a href="/work/luxury-listings-dr" data-route="work-luxury-listings-dr" data-card="Websites" aria-label="View the Luxury Listings DR case study" style="display:flex;flex-direction:column;gap:0;border-radius:26px;background:#0E0E12;border:1px solid rgba(248,250,252,.08);overflow:hidden;transition:transform .35s cubic-bezier(.22,.61,.36,1),border-color .35s ease" data-sh="13">
