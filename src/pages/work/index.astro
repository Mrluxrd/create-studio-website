    <p style="margin:2px 0 0;font-size:14.5px;color:#A1A1AA;line-height:1.7">A legal practice presented with the composure its clients expect. Currently in development.</p>
    <div style="font-size:12.5px;color:#52525B;line-height:1.6">Website Redesign · Content Hierarchy · User Experience</div>
    <span style="margin-top:auto;padding-top:16px;font-size:13.5px;color:#8B5CF6;display:flex;align-items:center;gap:8px">View Case Study <span aria-hidden="true">→</span></span>
  </div>
</a><a href="/work/custom-real-estate-crm" data-route="work-custom-real-estate-crm" data-card="CRM &amp; Systems" aria-label="View the Custom Real Estate CRM case study" style="display:flex;flex-direction:column;gap:0;border-radius:26px;background:#0E0E12;border:1px solid rgba(248,250,252,.08);overflow:hidden;transition:transform .35s cubic-bezier(.22,.61,.36,1),border-color .35s ease" data-sh="13">
  <div data-art-id="custom-real-estate-crm-case-study" data-art="" data-art-slot="" style="position:relative;aspect-ratio:16/9;width:100%;overflow:hidden;background:#0B0B0E;border:1px solid rgba(248,250,252,.07);display:flex;align-items:flex-end"><Artwork id="custom-real-estate-crm-case-study" />
  <div data-art-note="" style="padding:18px 20px;display:flex;flex-direction:column;gap:5px;max-width:520px">
