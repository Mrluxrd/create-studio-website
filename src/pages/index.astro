---
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import heroMockup from '../assets/hero-mockup-luxury-listings.png';
import Artwork from '../components/Artwork.astro';
---

<Base pageKey="home">
<main>
<section data-hero="" data-pad="" style="position:relative;min-height:0;overflow:hidden;padding:56px 72px 64px;display:flex;flex-direction:column;justify-content:flex-start;max-width:1440px;margin:0 auto">
  <div data-art-id="create-hero-motion" data-art="create-hero-motion" data-art-slot="" data-art-keep="" style="position:absolute;top:96px;right:-24px;width:700px;max-width:50%;display:flex;align-items:center;justify-content:center;pointer-events:none;z-index:2">
    <Picture
        src={heroMockup}
        formats={['webp']}
        fallbackFormat="png"
        widths={[520, 700, 1024, 1536]}
        sizes="(max-width: 900px) 92vw, (max-width: 1299px) 520px, 700px"
        alt="Luxury Listings DR, a Create Studio project, shown on a laptop and phone"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        style="width:100%;height:auto;display:block;filter:drop-shadow(0 46px 90px rgba(9,9,11,.75))"
      />
  </div>
  <div style="position:relative;z-index:2;max-width:720px;display:flex;flex-direction:column;gap:28px">
    
    <h1 data-h1="" style="margin:0;font-family:Sora,sans-serif;font-size:88px;line-height:.99;font-weight:700;letter-spacing:-0.035em">Ideas that move<br>business <span style="background:linear-gradient(90deg,#2563FF,#8B5CF6);-webkit-background-clip:text;background-clip:text;color:transparent">forward.</span></h1>
    <p data-lead="" style="margin:0;font-size:19px;line-height:1.62;color:#A1A1AA;max-width:540px;text-wrap:pretty">Create Studio builds distinctive websites, digital brands and custom systems for businesses ready to communicate with sharper clarity and operate with greater confidence.</p>
    <div data-row="" style="display:flex;gap:14px;align-items:center"><a href="/contact" data-route="contact" data-btn-primary="" style="padding:16px 30px;border-radius:999px;background:linear-gradient(90deg,#2563FF,#8B5CF6,#2563FF);font-weight:600;font-size:15px;transition:transform .25s ease,box-shadow .25s ease;text-align:center" data-sh="5">Start a Project</a><a href="/work" data-route="work" data-btn-ghost="" style="padding:16px 30px;border-radius:999px;border:1px solid rgba(248,250,252,.16);font-weight:500;font-size:15px;transition:background .25s ease,border-color .25s ease;text-align:center" data-sh="6">Explore Our Work</a></div>
    <div data-row="" style="display:flex;gap:40px;padding-top:26px;border-top:1px solid rgba(248,250,252,.08);margin-top:8px">
      <div style="display:flex;flex-direction:column;gap:5px"><div style="font-family:Sora,sans-serif;font-size:26px;font-weight:600">From US$800</div><div style="font-size:12.5px;color:#A1A1AA">Website packages</div></div>
      <div style="display:flex;flex-direction:column;gap:5px"><div style="font-family:Sora,sans-serif;font-size:26px;font-weight:600">Scoped</div><div style="font-size:12.5px;color:#A1A1AA">Timeline confirmed after discovery</div></div>
      <div style="display:flex;flex-direction:column;gap:5px"><div style="font-family:Sora,sans-serif;font-size:26px;font-weight:600">Custom</div><div style="font-size:12.5px;color:#A1A1AA">Built, never templated</div></div>
    </div>
  </div>
</section>

<div style="border-top:1px solid rgba(248,250,252,.07);border-bottom:1px solid rgba(248,250,252,.07);padding:20px 0;overflow:hidden;background:#0B0B0E">
  <div style="display:flex;gap:52px;width:max-content;animation:csMarquee 34s linear infinite;font-family:Inter,system-ui,sans-serif;font-weight:500;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:#A1A1AA">
    <span>Creative thinking</span><span style="color:#8B5CF6">◆</span><span>Clear business purpose</span><span style="color:#8B5CF6">◆</span><span>Every detail has a job</span><span style="color:#8B5CF6">◆</span><span>Creative thinking</span><span style="color:#8B5CF6">◆</span><span>Clear business purpose</span><span style="color:#8B5CF6">◆</span><span>Every detail has a job</span><span style="color:#8B5CF6">◆</span>
  </div>
</div>

<section data-sect="" data-pad="" style="position:relative;overflow:hidden;padding:118px 72px;max-width:1440px;margin:0 auto">
  <div data-art-id="create-portfolio-accent" data-art="create-portfolio-accent" data-art-slot="" style="position:absolute;left:50%;top:50px;transform:translateX(-50%);width:1180px;height:470px;border-radius:32px;overflow:hidden;background:#0B0B0E;border:1px solid rgba(248,250,252,.07);display:flex;align-items:flex-end;pointer-events:none"><Artwork id="create-portfolio-accent" />
    <div data-art-note="" data-art-label="" style="position:absolute;left:0;top:0;box-sizing:border-box;display:flex;padding:14px 18px;border-radius:12px;background:rgba(9,9,11,.82);border:1px solid rgba(248,250,252,.14);flex-direction:column;gap:6px;max-width:520px">
      <span style="font-family:Inter,system-ui,sans-serif;font-weight:500;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#8B5CF6">ARTWORK — SELECTED WORK</span>
      <span style="font-family:Inter,system-ui,sans-serif;font-weight:500;font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:#71717A">Artwork Placeholder</span>
      <span style="font-family:Inter,system-ui,sans-serif;font-size:11px;line-height:1.6;color:#52525B">21:9 desktop · 16:9 tablet · 3:2 mobile · low band · upper 55% reserved for heading</span>
      <span style="font-family:Inter,system-ui,sans-serif;font-size:10.5px;line-height:1.6;color:#3F3F46">Final artwork supplied separately</span>
    </div>
  </div>
  <div style="position:relative;z-index:2;display:flex;flex-direction:column;gap:44px">
    <div data-row="" style="display:flex;align-items:flex-end;justify-content:space-between;gap:24px">
      <div style="display:flex;flex-direction:column;gap:14px"><div style="font-family:Inter,system-ui,sans-serif;font-weight:500;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:#8B5CF6">Portfolio</div><h2 data-h2="" data-rv="" style="margin:0;font-family:Sora,sans-serif;font-size:52px;font-weight:600;letter-spacing:-0.03em;line-height:1.06;max-width:600px">Different work. One standard.</h2></div>
      <a href="/work" data-route="work" data-btn-ghost="" style="padding:16px 30px;border-radius:999px;border:1px solid rgba(248,250,252,.16);font-weight:500;font-size:15px;transition:background .25s ease,border-color .25s ease;text-align:center" data-sh="6">Explore Our Work</a>
    </div>
    <div data-cols="" style="display:grid;grid-template-columns:1.4fr 1fr;gap:24px">
      <a href="/work/create-studio" data-route="work-create-studio" aria-label="View the Create Studio case study" style="display:flex;flex-direction:column;gap:16px;padding:16px;border-radius:26px;background:#0E0E12;border:1px solid rgba(139,92,246,.28);transition:transform .35s ease,border-color .35s ease" data-sh="7">
        <div style="position:relative;flex:1;min-height:390px;border-radius:16px;overflow:hidden;background:radial-gradient(120% 140% at 22% 12%,rgba(37,99,255,.14),rgba(9,9,11,0) 62%),#0B0B0E;border:1px solid rgba(248,250,252,.07);display:flex;align-items:center;justify-content:center;text-align:center;"><div style="font-family:Inter,system-ui,sans-serif;font-weight:500;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#A1A1AA;line-height:1.8;padding:0 16px">Create Studio</div></div>
        <div style="padding:8px 10px 12px;display:flex;flex-direction:column;gap:9px">
          <div data-row="" style="display:flex;align-items:baseline;justify-content:space-between;gap:12px"><h3 data-h3="" style="margin:0;font-family:Sora,sans-serif;font-size:23px;font-weight:600">Create Studio</h3><span style="font-size:12.5px;color:#A1A1AA">Studio Website and Digital Brand</span></div>
          <p style="margin:0;font-size:14px;color:#A1A1AA;line-height:1.65;max-width:520px">Our own brand and website, built as one system — the clearest statement of how we think about design, technology and commercial intent.</p>
          <span style="font-size:13px;color:#8B5CF6">View Case Study <span aria-hidden="true">→</span></span>
        </div>
      </a>
      <div style="display:flex;flex-direction:column;gap:24px">
        <a href="/work/joan-leonardo" data-route="work-joan-leonardo" style="display:flex;flex-direction:column;gap:14px;padding:16px;border-radius:26px;background:#0E0E12;border:1px solid rgba(248,250,252,.08);transition:transform .35s ease,border-color .35s ease;flex:1" data-sh="8">
          <div style="position:relative;height:150px;border-radius:16px;overflow:hidden;background:radial-gradient(120% 140% at 22% 12%,rgba(37,99,255,.14),rgba(9,9,11,0) 62%),#0B0B0E;border:1px solid rgba(248,250,252,.07);display:flex;align-items:center;justify-content:center;text-align:center;"><div style="font-family:Inter,system-ui,sans-serif;font-weight:500;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#A1A1AA;line-height:1.8;padding:0 16px">Project imagery</div></div>
          <div style="padding:4px 8px 8px;display:flex;flex-direction:column;gap:7px">
            <div data-row="" style="display:flex;align-items:baseline;justify-content:space-between;gap:10px"><h3 style="margin:0;font-family:Sora,sans-serif;font-size:18px;font-weight:600">Joan Leonardo</h3><span style="font-size:12px;color:#A1A1AA">Legal Website</span></div>
            <p style="margin:0;font-size:13px;color:#A1A1AA;line-height:1.6">A legal practice presented with the composure its clients expect. Currently in development.</p>
            <span style="font-size:12.5px;color:#8B5CF6">View Case Study <span aria-hidden="true">→</span></span>
          </div></a><a href="/work/custom-real-estate-crm" data-route="work-custom-real-estate-crm" style="display:flex;flex-direction:column;gap:14px;padding:16px;border-radius:26px;background:#0E0E12;border:1px solid rgba(248,250,252,.08);transition:transform .35s ease,border-color .35s ease;flex:1" data-sh="8">
          <div style="position:relative;height:150px;border-radius:16px;overflow:hidden;background:radial-gradient(120% 140% at 22% 12%,rgba(37,99,255,.14),rgba(9,9,11,0) 62%),#0B0B0E;border:1px solid rgba(248,250,252,.07);display:flex;align-items:center;justify-content:center;text-align:center;"><div style="font-family:Inter,system-ui,sans-serif;font-weight:500;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#A1A1AA;line-height:1.8;padding:0 16px">Project imagery</div></div>
          <div style="padding:4px 8px 8px;display:flex;flex-direction:column;gap:7px">
            <div data-row="" style="display:flex;align-items:baseline;justify-content:space-between;gap:10px"><h3 style="margin:0;font-family:Sora,sans-serif;font-size:18px;font-weight:600">Custom Real Estate CRM</h3><span style="font-size:12px;color:#A1A1AA">Custom Digital System</span></div>
            <p style="margin:0;font-size:13px;color:#A1A1AA;line-height:1.6">A system shaped around one brokerage’s real workflow: contacts, properties, opportunities and follow-ups in a single place. In development.</p>
            <span style="font-size:12.5px;color:#8B5CF6">View Case Study <span aria-hidden="true">→</span></span>
          </div></a><a href="/work/luxury-listings-dr" data-route="work-luxury-listings-dr" aria-label="View the Luxury Listings DR case study" style="display:flex;flex-direction:column;gap:14px;padding:16px;border-radius:26px;background:#0E0E12;border:1px solid rgba(248,250,252,.08);transition:transform .35s ease,border-color .35s ease;flex:1" data-sh="8">
          <div style="position:relative;height:150px;border-radius:16px;overflow:hidden;background:radial-gradient(120% 140% at 22% 12%,rgba(37,99,255,.14),rgba(9,9,11,0) 62%),#0B0B0E;border:1px solid rgba(248,250,252,.07);display:flex;align-items:center;justify-content:center;text-align:center;"><div style="font-family:Inter,system-ui,sans-serif;font-weight:500;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#A1A1AA;line-height:1.8;padding:0 16px">Project imagery</div></div>
          <div style="padding:4px 8px 8px;display:flex;flex-direction:column;gap:7px">
            <div data-row="" style="display:flex;align-items:baseline;justify-content:space-between;gap:10px"><h3 style="margin:0;font-family:Sora,sans-serif;font-size:18px;font-weight:600">Luxury Listings DR</h3><span style="font-size:12px;color:#A1A1AA">Luxury Real Estate Platform</span></div>
            <p style="margin:0;font-size:13px;color:#A1A1AA;line-height:1.6">Luxury property discovery, made visual and unhurried. In development.</p>
            <span style="font-size:12.5px;color:#8B5CF6">View Case Study <span aria-hidden="true">→</span></span>
          </div></a>
      </div>
    </div>
  </div>
</section>

<section data-sect="" data-pad="" style="padding:110px 72px;max-width:1440px;margin:0 auto;display:flex;flex-direction:column;gap:48px;background:#0B0B0E;border-top:1px solid rgba(248,250,252,.06);border-bottom:1px solid rgba(248,250,252,.06)">
  <div data-cols="" style="display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start">
    <div style="display:flex;flex-direction:column;gap:20px">
      <div style="font-family:Inter,system-ui,sans-serif;font-weight:500;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:#8B5CF6">Web design &amp; development — our primary service</div>
      <h2 data-h2="" data-rv="" style="margin:0;font-family:Sora,sans-serif;font-size:52px;font-weight:600;letter-spacing:-0.03em;line-height:1.06">One studio across every layer of your digital presence.</h2>
      <p data-lead="" style="margin:0;font-size:16.5px;line-height:1.75;color:#A1A1AA;max-width:520px">Brand thinking, design, engineering and long-term care are handled under one roof — so nothing arrives disconnected from the decision that came before it.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:4px"><span style="padding:9px 15px;border-radius:999px;border:1px solid rgba(248,250,252,.12);font-size:12.5px;color:#A1A1AA">Landing pages</span><span style="padding:9px 15px;border-radius:999px;border:1px solid rgba(248,250,252,.12);font-size:12.5px;color:#A1A1AA">Corporate websites</span><span style="padding:9px 15px;border-radius:999px;border:1px solid rgba(248,250,252,.12);font-size:12.5px;color:#A1A1AA">Professional services</span><span style="padding:9px 15px;border-radius:999px;border:1px solid rgba(248,250,252,.12);font-size:12.5px;color:#A1A1AA">Portfolio</span><span style="padding:9px 15px;border-radius:999px;border:1px solid rgba(248,250,252,.12);font-size:12.5px;color:#A1A1AA">Catalog</span><span style="padding:9px 15px;border-radius:999px;border:1px solid rgba(248,250,252,.12);font-size:12.5px;color:#A1A1AA">Multilingual</span><span style="padding:9px 15px;border-radius:999px;border:1px solid rgba(248,250,252,.12);font-size:12.5px;color:#A1A1AA">Conversion-focused</span><span style="padding:9px 15px;border-radius:999px;border:1px solid rgba(248,250,252,.12);font-size:12.5px;color:#A1A1AA">Responsive on every device</span></div>
      <div style="margin-top:8px"><a href="/services/web-design-development" data-route="service-web-design-development" data-btn-ghost="" style="padding:16px 30px;border-radius:999px;border:1px solid rgba(248,250,252,.16);font-weight:500;font-size:15px;transition:background .25s ease,border-color .25s ease;text-align:center" data-sh="6">Explore Web Design &amp; Development</a></div>
    </div>
    <div style="display:flex;flex-direction:column;gap:16px">
      <div style="padding:28px 30px;border-radius:22px;background:#0E0E12;border:1px solid rgba(248,250,252,.08);display:flex;gap:22px;align-items:flex-start;transition:border-color .3s ease" data-sh="9"><span style="font-family:Inter,system-ui,sans-serif;font-weight:500;font-size:11px;color:#8B5CF6;padding-top:5px">01</span><div><h3 data-h3="" style="margin:0 0 7px;font-family:Sora,sans-serif;font-size:22px;font-weight:600">Creative</h3><p style="margin:0;font-size:14.5px;color:#A1A1AA;line-height:1.65">A distinctive visual point of view, drawn from your brand rather than a trend.</p></div></div><div style="padding:28px 30px;border-radius:22px;background:#0E0E12;border:1px solid rgba(248,250,252,.08);display:flex;gap:22px;align-items:flex-start;transition:border-color .3s ease" data-sh="9"><span style="font-family:Inter,system-ui,sans-serif;font-weight:500;font-size:11px;color:#8B5CF6;padding-top:5px">02</span><div><h3 data-h3="" style="margin:0 0 7px;font-family:Sora,sans-serif;font-size:22px;font-weight:600">Strategic</h3><p style="margin:0;font-size:14.5px;color:#A1A1AA;line-height:1.65">Structure and hierarchy that give attention somewhere useful to go.</p></div></div><div style="padding:28px 30px;border-radius:22px;background:#0E0E12;border:1px solid rgba(248,250,252,.08);display:flex;gap:22px;align-items:flex-start;transition:border-color .3s ease" data-sh="9"><span style="font-family:Inter,system-ui,sans-serif;font-weight:500;font-size:11px;color:#8B5CF6;padding-top:5px">03</span><div><h3 data-h3="" style="margin:0 0 7px;font-family:Sora,sans-serif;font-size:22px;font-weight:600">Custom</h3><p style="margin:0;font-size:14.5px;color:#A1A1AA;line-height:1.65">Shaped around how your business actually runs — content, process and objectives included.</p></div></div>
    </div>
  </div>
</section>

<section data-sect="" data-pad="" style="padding:110px 72px;max-width:1440px;margin:0 auto;display:flex;flex-direction:column;gap:40px">
  <div data-row="" style="display:flex;align-items:flex-end;justify-content:space-between;gap:24px">
    <div style="display:flex;flex-direction:column;gap:14px"><div style="font-family:Inter,system-ui,sans-serif;font-weight:500;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:#8B5CF6">Website packages · one-time project price</div><h2 data-h2="" data-rv="" style="margin:0;font-family:Sora,sans-serif;font-size:48px;font-weight:600;letter-spacing:-0.03em;line-height:1.08;max-width:620px">Clear scope. Clear price. No guesswork.</h2></div>
    <a href="/pricing" data-route="pricing" data-btn-ghost="" style="padding:16px 30px;border-radius:999px;border:1px solid rgba(248,250,252,.16);font-weight:500;font-size:15px;transition:background .25s ease,border-color .25s ease;text-align:center" data-sh="6">Compare Website Packages</a>
  </div>
  <div data-cols="" style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px;align-items:stretch">
    <div style="position:relative;padding:32px 28px;border-radius:24px;background:#0E0E12;border:1px solid rgba(248,250,252,.08);display:flex;flex-direction:column;gap:18px">
      
      <div style="display:flex;flex-direction:column;gap:8px"><h3 data-h3="" style="margin:0;font-family:Sora,sans-serif;font-size:20px;font-weight:600">Essential</h3><div style="font-family:Sora,sans-serif;font-size:32px;font-weight:600;letter-spacing:-0.03em">US$800</div><p style="margin:0;font-size:13px;color:#A1A1AA;line-height:1.6">Landing page or compact digital presence.</p></div>
      <div style="display:flex;flex-direction:column;gap:9px;padding-top:16px;border-top:1px solid rgba(248,250,252,.08)"><div style="display:flex;gap:10px;align-items:flex-start;font-size:13.5px;color:#A1A1AA;line-height:1.55"><span style="width:5px;height:5px;border-radius:99px;background:#8B5CF6;margin-top:7px;flex:none"></span><span>Page count confirmed in the approved project scope</span></div><div style="display:flex;gap:10px;align-items:flex-start;font-size:13.5px;color:#A1A1AA;line-height:1.55"><span style="width:5px;height:5px;border-radius:99px;background:#8B5CF6;margin-top:7px;flex:none"></span><span>Custom design</span></div><div style="display:flex;gap:10px;align-items:flex-start;font-size:13.5px;color:#A1A1AA;line-height:1.55"><span style="width:5px;height:5px;border-radius:99px;background:#8B5CF6;margin-top:7px;flex:none"></span><span>Responsive design</span></div><div style="display:flex;gap:10px;align-items:flex-start;font-size:13.5px;color:#A1A1AA;line-height:1.55"><span style="width:5px;height:5px;border-radius:99px;background:#8B5CF6;margin-top:7px;flex:none"></span><span>Contact form and WhatsApp</span></div><div style="display:flex;gap:10px;align-items:flex-start;font-size:13.5px;color:#A1A1AA;line-height:1.55"><span style="width:5px;height:5px;border-radius:99px;background:#8B5CF6;margin-top:7px;flex:none"></span><span>Basic SEO</span></div><div style="display:flex;gap:10px;align-items:flex-start;font-size:13.5px;color:#A1A1AA;line-height:1.55"><span style="width:5px;height:5px;border-radius:99px;background:#8B5CF6;margin-top:7px;flex:none"></span><span>Website publication</span></div></div>
      <a href="/contact?package=essential" data-route="contact" style="margin-top:auto;padding:14px;border-radius:999px;border:1px solid rgba(248,250,252,.16);font-weight:500;text-align:center;font-size:13.5px;transition:transform .25s ease" data-sh="10">Choose Essential</a>
    </div><div style="position:relative;padding:32px 28px;border-radius:24px;background:#0E0E12;border:1px solid transparent;background-image:linear-gradient(#0E0E12,#0E0E12),linear-gradient(135deg,#2563FF,#8B5CF6);background-origin:border-box;background-clip:padding-box,border-box;display:flex;flex-direction:column;gap:18px">
