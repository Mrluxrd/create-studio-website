---
// Primary site chrome. Markup preserved from the approved Claude Design prototype;
// the active-navigation state is rendered on the server instead of being applied
// by script after hydration.
import { Image } from 'astro:assets';
import logoLockup from '../assets/logo-lockup.png';

interface Props {
  navActive?: string;
}
const { navActive = '' } = Astro.props;
const navStyle = (key: string) => `color:${navActive === key ? '#F8FAFC' : '#A1A1AA'}`;
---
<header style="position:sticky;top:0;z-index:60;background:rgba(9,9,11,.8);backdrop-filter:blur(18px);border-bottom:1px solid rgba(248,250,252,.06)">
  <div data-pad="" style="max-width:1440px;margin:0 auto;padding:18px 72px;display:flex;align-items:center;justify-content:space-between;gap:32px">
    <a href="/" data-route="home" aria-label="Create Studio home" style="display:flex;flex:none"><Image src={logoLockup} alt="Create Studio logo" loading="eager" decoding="async" style="height:48px;width:auto;display:block" /></a>
    <nav data-desk="" aria-label="Primary" style="display:flex;align-items:center;gap:30px;font-size:14px">
      <a href="/" data-route="home" data-nav="home" style={navStyle('home')} aria-current={navActive === 'home' ? 'page' : undefined}>Home</a>
      <div data-svc-wrap="" data-open="false" style="position:relative;display:flex;align-items:center">
        <button type="button" data-svc-trigger="" aria-current={navActive === 'services' ? 'page' : undefined} data-nav="services" aria-haspopup="true" aria-expanded="false" aria-controls="services-menu" data-on-click="toggleDropdown" data-on-keydown="dropdownKeys" style={'color:' + (navActive === 'services' ? '#F8FAFC' : '#A1A1AA') + ';display:flex;align-items:center;gap:7px;background:transparent;border:none;padding:0;margin:0;font-family:Inter,system-ui,sans-serif;font-size:14px;line-height:1;cursor:pointer'}>Services<span data-svc-caret="" style="display:inline-block;width:5px;height:5px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(45deg) translateY(-1px);transition:transform .25s ease"></span></button>
        <div data-dropdown="" id="services-menu" aria-label="Services" style="position:fixed;top:82px;left:50%;transform:translateX(-50%) translateY(-8px);width:min(680px, calc(100vw - 44px));box-sizing:border-box;padding:14px;border-radius:22px;background:#0E0E12;border:1px solid rgba(248,250,252,.1);box-shadow:0 40px 90px rgba(0,0,0,.65);display:grid;grid-template-columns:1fr 1fr;gap:6px;display:none;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .28s ease,transform .28s ease,visibility .28s">
          <a href="/services/web-design-development" data-route="service-web-design-development" style="grid-column:1/-1;padding:20px;border-radius:16px;background:linear-gradient(120deg,rgba(37,99,255,.16),rgba(139,92,246,.09));border:1px solid rgba(139,92,246,.3);display:flex;flex-direction:column;gap:6px;transition:border-color .25s ease" data-sh="1"><span style="display:flex;align-items:center;gap:10px;font-family:Sora,sans-serif;font-size:17px;font-weight:600">Web Design &amp; Development</span><span style="font-size:13px;color:#A1A1AA;line-height:1.55">Landing pages, corporate sites, catalogs and multilingual platforms.</span></a><a href="/services/website-redesign" data-route="service-website-redesign" style="padding:15px 16px;border-radius:14px;display:flex;flex-direction:column;gap:4px;transition:background .25s ease" data-sh="2"><span style="display:flex;align-items:center;gap:9px;font-size:14.5px;font-weight:500">Website Redesign</span><span style="font-size:12.5px;color:#A1A1AA;line-height:1.5">Modernise, reorganise and convert better.</span></a><a href="/services/crm-custom-systems" data-route="service-crm-custom-systems" style="padding:15px 16px;border-radius:14px;display:flex;flex-direction:column;gap:4px;transition:background .25s ease" data-sh="2"><span style="display:flex;align-items:center;gap:9px;font-size:14.5px;font-weight:500">CRM &amp; Custom Systems</span><span style="font-size:12.5px;color:#A1A1AA;line-height:1.5">Dashboards, pipelines, calendars, reports, automations.</span></a><a href="/services/seo-performance" data-route="service-seo-performance" style="padding:15px 16px;border-radius:14px;display:flex;flex-direction:column;gap:4px;transition:background .25s ease" data-sh="2"><span style="display:flex;align-items:center;gap:9px;font-size:14.5px;font-weight:500">SEO &amp; Performance</span><span style="font-size:12.5px;color:#A1A1AA;line-height:1.5">Structure, speed, indexing and continuous optimisation.</span></a><a href="/services/hosting-maintenance" data-route="service-hosting-maintenance" style="padding:15px 16px;border-radius:14px;display:flex;flex-direction:column;gap:4px;transition:background .25s ease" data-sh="2"><span style="display:flex;align-items:center;gap:9px;font-size:14.5px;font-weight:500">Hosting &amp; Maintenance</span><span style="font-size:12.5px;color:#A1A1AA;line-height:1.5">SSL, monitoring, backups and technical support.</span></a><a href="/services/digital-branding" data-route="service-digital-branding" style="padding:15px 16px;border-radius:14px;display:flex;flex-direction:column;gap:4px;transition:background .25s ease" data-sh="2"><span style="display:flex;align-items:center;gap:9px;font-size:14.5px;font-weight:500">Digital Branding</span><span style="font-size:12.5px;color:#A1A1AA;line-height:1.5">Visual direction, logo systems, colour and typography.</span></a>
          <a href="/services" data-route="services" style="grid-column:1/-1;margin-top:2px;padding:14px 16px;border-top:1px solid rgba(248,250,252,.07);font-size:13px;color:#A1A1AA">All services →</a>
        </div>
      </div>
      <a href="/work" data-route="work" data-nav="work" style={navStyle('work')} aria-current={navActive === 'work' ? 'page' : undefined}>Work</a>
      <a href="/process" data-route="process" data-nav="process" style={navStyle('process')} aria-current={navActive === 'process' ? 'page' : undefined}>Process</a>
      <a href="/pricing" data-route="pricing" data-nav="pricing" style={navStyle('pricing')} aria-current={navActive === 'pricing' ? 'page' : undefined}>Pricing</a>
      <a href="/about" data-route="about" data-nav="about" style={navStyle('about')} aria-current={navActive === 'about' ? 'page' : undefined}>About</a>
      <a href="/contact" data-route="contact" data-nav="contact" style={navStyle('contact')} aria-current={navActive === 'contact' ? 'page' : undefined}>Contact</a>
    </nav>
    <a data-desk="" href="/contact" data-route="contact" style="flex:none;padding:12px 24px;border-radius:999px;background:linear-gradient(90deg,#2563FF,#8B5CF6);font-weight:600;font-size:14px;transition:transform .25s ease,box-shadow .25s ease" data-sh="3">Start a Project</a>
    <button data-mob="" aria-label="Open menu" aria-expanded="false" data-on-click="openMenu" style="display:none;flex:none;align-items:center;justify-content:center;width:46px;height:46px;border-radius:14px;border:1px solid rgba(248,250,252,.14);background:transparent;cursor:pointer;flex-direction:column;gap:5px">
      <span style="width:20px;height:1.5px;background:#F8FAFC;display:block"></span>
      <span style="width:13px;height:1.5px;background:#F8FAFC;display:block;align-self:flex-end;margin-right:13px"></span>
    </button>
  </div>
</header>
